# cp wrangler.toml.example wrangler.toml して編集する。
# デプロイ: cd worker && npx wrangler deploy
# 秘密:    npx wrangler secret put NJA_LICENSE_SECRET   # リポジトリ直下の .license-secret と同じ値
#          npx wrangler secret put STRIPE_SECRET_KEY    # Stripe の制限付きキー（Checkout Sessions: 読み取り）
name = "normalize-jpn-address-license"
main = "license-worker.mjs"
compatibility_date = "2026-09-01"

# 例: https://license.pizzabun-lab.com/thanks?session_id={CHECKOUT_SESSION_ID} を
# Stripe Payment Link の「支払い後の遷移先」に設定する
routes = [
  { pattern = "license.pizzabun-lab.com", custom_domain = true }
]
